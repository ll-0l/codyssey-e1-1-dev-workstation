# 17. 캐시 무시 재빌드 + 이미지/컨테이너/볼륨 정리 (2026-11-20 18:29:35 KST)

## 1) 캐시 사용 빌드 vs 캐시 무시 빌드

$ docker build -t codyssey-web:1.0 ./app 2>&1 | grep -E 'CACHED|DONE|naming' 
#1 DONE 0.0s
#2 DONE 0.0s
#3 DONE 0.0s
#4 DONE 0.0s
#6 DONE 0.0s
#5 DONE 1.6s
#7 CACHED
#8 CACHED
#9 naming to docker.io/library/codyssey-web:1.0 done
#9 DONE 0.1s

$ docker build --no-cache --pull -t codyssey-web:1.0 ./app 2>&1 | grep -E 'CACHED|FROM|COPY|DONE|naming'
#1 DONE 0.0s
#2 DONE 0.7s
#3 DONE 0.0s
#4 DONE 0.0s
#5 [1/3] FROM docker.io/library/nginx:alpine@sha256:fb4658584bd9a916ffb6f6e365f97c25cfdb2923801f551ea08356e695f14ff7
#5 CACHED
#6 [2/3] COPY nginx/default.conf /etc/nginx/conf.d/default.conf
#6 DONE 0.0s
#7 [3/3] COPY site/ /usr/share/nginx/html/
#7 DONE 0.0s
#8 naming to docker.io/library/codyssey-web:1.0 done
#8 DONE 0.2s

