$ docker compose ps
NAME             IMAGE              COMMAND                  SERVICE   CREATED          STATUS                                     PORTS
codyssey-api-1   codyssey-api:1.0   "python app.py"          api       11 seconds ago   Up 11 seconds (healthy)                    7000/tcp
codyssey-web-1   codyssey-web:1.0   "/docker-entrypoint.…"   web       11 seconds ago   Up Less than a second (health: starting)   0.0.0.0:8091->80/tcp

$ curl -s http://localhost:8091/api/info
{"service": "api", "hostname": "09c57ae2fe1f", "port": 7000, "mode": "prod", "time": "2026-11-19T06:16:38+00:00"}
$ docker compose exec api printenv PORT APP_MODE
